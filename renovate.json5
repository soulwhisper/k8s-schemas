{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>soulwhisper/renovate-config"],
  packageRules: [
    {
      description: "Auto-merge GitHub Actions non-major bumps",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge CRD upstream",
      matchManagers: ["vendir"],
      groupName: "vendir crd schemas",
      groupSlug: "vendir",
      separateMajorMinor: false,
      separateMinorPatch: false,
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "vendir: unprefixed-semver extraction for chart-family tags (cloudnative-pg)",
      matchManagers: ["vendir"],
      matchDepNames: ["https://github.com/cloudnative-pg/charts"],
      versionCompatibility: "^(?<compatibility>cloudnative-pg)-v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      description: "vendir: unprefixed-semver extraction for chart-family tags (prometheus-operator-crds)",
      matchManagers: ["vendir"],
      matchDepNames: ["https://github.com/prometheus-community/helm-charts"],
      versionCompatibility: "^(?<compatibility>prometheus-operator-crds)-(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      description: "vendir: unprefixed-semver extraction for chart-family tags (victoria-metrics-operator-crds)",
      matchManagers: ["vendir"],
      matchDepNames: ["https://github.com/VictoriaMetrics/helm-charts"],
      versionCompatibility: "^(?<compatibility>victoria-metrics-operator-crds)-(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
  ],
}
